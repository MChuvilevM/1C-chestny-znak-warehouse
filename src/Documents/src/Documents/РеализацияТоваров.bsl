Процедура ОбработкаПроведения(Отказ, Режим)

	Движения.ОстаткиТоваров.Записывать = Истина;

	// 1. Проверяем остатки товаров на складе с помощью SQL-подобного запроса к виртуальной таблице
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОстаткиТоваровОстатки.Номенклатура КАК Номенклатура,
		|	ОстаткиТоваровОстатки.КоличествоОстаток КАК КоличествоОстаток
		|ИЗ
		|	РегистрНакопления.ОстаткиТоваров.Остатки(&МоментВремени, Номенклатура В (&СписокНоменклатуры)) КАК ОстаткиТоваровОстатки";

	Запрос.УстановитьПараметр("МоментВремени", Новый Граница(МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("СписокНоменклатуры", Товары.ВыгрузитьКолонку("Номенклатура"));

	ОстаткиВБазе = Запрос.Выполнить().Выгрузить();

	Для Каждого ТекСтрокаТовара Из Товары Цикл

		// Проверка 1: Хватает ли товара на складе (защита от ухода в минус)
		НайденныйОстаток = ОстаткиВБазе.Найти(ТекСтрокаТовара.Номенклатура, "Номенклатура");
		Доступно = ?(НайденныйОстаток = Неопределено, 0, НайденныйОстаток.КоличествоОстаток);

		Если ТекСтрокаТовара.Количество > Доступно Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Нехватка товара «" + ТекСтрокаТовара.Номенклатура + "»! На складе: " + Доступно + ", требуется: " + ТекСтрокаТовара.Количество;
			Сообщение.Сообщить();
			Отказ = Истина;
			Продолжить;
		КонецЕсли;

		// Проверка 2: Контроль кода «Честного знака» при отгрузке
		Если ТекСтрокаТовара.Номенклатура.МаркируемыйТовар И ПустаяСтрока(ТекСтрокаТовара.КодМаркировки) Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Ошибка маркировки! Для отгрузки товара «" + ТекСтрокаТовара.Номенклатура + "» необходимо отсканировать код DataMatrix.";
			Сообщение.Сообщить();
			Отказ = Истина;
			Продолжить;
		КонецЕсли;

		// 3. Списываем товар со склада (ВидДвижения = Расход)
		Движение = Движения.ОстаткиТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Номенклатура = ТекСтрокаТовара.Номенклатура;
		Движение.Количество = ТекСтрокаТовара.Количество;

		// 4. Проверяем, числится ли марка на нашем балансе, и списываем её из пула активных марок
		Если ТекСтрокаТовара.Номенклатура.МаркируемыйТовар Тогда
			НаборЗаписей = РегистрыСведений.КодыМаркировки.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.КодМаркировки.Установить(ТекСтрокаТовара.КодМаркировки);
			НаборЗаписей.Прочитать();

			Если НаборЗаписей.Количество() = 0 Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Код маркировки «" + ТекСтрокаТовара.КодМаркировки + "» не числится на балансе организации!";
				Сообщение.Сообщить();
				Отказ = Истина;
				Продолжить;
			КонецЕсли;

			// Удаляем проданную марку из пула активных кодов на складе
			НаборЗаписей.Очистить();
			НаборЗаписей.Записать();
		КонецЕсли;


	КонецЦикла;

КонецПроцедуры
