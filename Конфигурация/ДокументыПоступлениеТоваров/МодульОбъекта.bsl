Процедура ОбработкаПроведения(Отказ, Режим)

	Движения.ОстаткиТоваров.Записывать = Истина;

	Для Каждого ТекСтрокаТовары Из Товары Цикл

		// 1. Контроль «Честного знака» при приёмке
		Если ТекСтрокаТовары.Номенклатура.МаркируемыйТовар И ПустаяСтрока(ТекСтрокаТовары.КодМаркировки) Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Ошибка маркировки! Для товара «" + ТекСтрокаТовары.Номенклатура + "» не отсканирован код DataMatrix.";
			Сообщение.Сообщить();
			Отказ = Истина;
			Продолжить;
		КонецЕсли;

		// 2. Приход на остатки склада (Регистр накопления)
		Движение = Движения.ОстаткиТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Номенклатура = ТекСтрокаТовары.Номенклатура;
		Движение.Количество = ТекСтрокаТовары.Количество;

		// 3. Записываем код маркировки в независимый регистр пула активных марок
		Если ТекСтрокаТовары.Номенклатура.МаркируемыйТовар Тогда
			МенеджерЗаписи = РегистрыСведений.КодыМаркировки.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.КодМаркировки = ТекСтрокаТовары.КодМаркировки;
			МенеджерЗаписи.Номенклатура = ТекСтрокаТовары.Номенклатура;
			МенеджерЗаписи.ВНаличии = Истина;
			МенеджерЗаписи.Записать();
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры
