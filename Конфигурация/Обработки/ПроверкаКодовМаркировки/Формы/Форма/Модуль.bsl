#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПроверитьКод(Команда)
	
	Если ПустаяСтрока(КодDataMatrix) Тогда
		ПоказатьПредупреждение(, "Введите или отсканируйте код маркировки GS1 DataMatrix!");
		Возврат;
	КонецЕсли;
	
	// Очищаем поля перед новой проверкой
	GTIN = "";
	СерийныйНомер = "";
	СтатусВБазе = "";
	НайденнаяНоменклатура = Неопределено;
	
	// Вызываем серверную процедуру с контекстом формы
	ПроверитьКодНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьВнешнийAPI(Команда)
	
	Если ПустаяСтрока(GTIN) Тогда
		ПоказатьПредупреждение(, "Сначала выполните проверку кода маркировки, чтобы выделить GTIN!");
		Возврат;
	КонецЕсли;
	
	ОтветВнешнегоAPI = "Выполняется запрос к внешнему REST API...";
	
	// Передаём только строку GTIN в серверную функцию без контекста,
	// чтобы не гонять весь контекст формы по сети (best practice 1С)
	ОтветВнешнегоAPI = ЗапроситьВнешнийAPIНаСервереБезКонтекста(GTIN);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПроверитьКодНаСервере()
	
	// 1. Очистка от пробелов и служебного разделителя GS (ASCII 29), если сканировали 2D-сканером
	ОчищенныйКод = СокрЛП(КодDataMatrix);
	ОчищенныйКод = СтрЗаменить(ОчищенныйКод, Символ(29), "");
	
	// 2. Парсинг GS1 DataMatrix:
	// Формат базовой части: "01" (2 симв.) + GTIN (14 симв.) + "21" (2 симв.) + Серийный номер (13 симв.)
	Если СтрДлина(ОчищенныйКод) < 19
		Или Лев(ОчищенныйКод, 2) <> "01"
		Или Сред(ОчищенныйКод, 17, 2) <> "21" Тогда
		
		СтатусВБазе = "Ошибка формата: строка не соответствует стандарту GS1 DataMatrix (ожидается 01...21...)";
		Возврат;
	КонецЕсли;
	
	GTIN = Сред(ОчищенныйКод, 3, 14);
	// Берём первые 13 символов серийного номера после идентификатора "21" (отсекая криптохвост 91/92 при наличии)
	СерийныйНомер = Сред(ОчищенныйКод, 19, 13);
	
	// 3. Проверка наличия кода в независимом регистре сведений КодыМаркировки
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	КодыМаркировки.Номенклатура КАК Номенклатура,
		|	КодыМаркировки.ВНаличии КАК ВНаличии
		|ИЗ
		|	РегистрСведений.КодыМаркировки КАК КодыМаркировки
		|ГДЕ
		|	КодыМаркировки.КодМаркировки = &КодМаркировки";
		
	Запрос.УстановитьПараметр("КодМаркировки", ОчищенныйКод);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		НайденнаяНоменклатура = Выборка.Номенклатура;
		Если Выборка.ВНаличии Тогда
			СтатусВБазе = "ОК: Код найден в пуле марок и числится В НАЛИЧИИ на складе.";
		Иначе
			СтатусВБазе = "ВНИМАНИЕ: Код найден в базе, но марка уже СПИСАНА (ВНаличии = Ложь).";
		КонецЕсли;
	Иначе
		СтатусВБазе = "НЕ НАЙДЕН: Данный код маркировки отсутствует в регистре сведений.";
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗапроситьВнешнийAPIНаСервереБезКонтекста(Знач ПереданныйGTIN)
	
	// Обращаемся к открытому REST API OpenFoodFacts v2, который принимает GTIN/штрихкод и отдаёт JSON
	Сервер = "world.openfoodfacts.org";
	Ресурс = "/api/v2/product/" + ПереданныйGTIN + ".json";
	
	Попытка
		// Инициализируем защищённое HTTPS-соединение (порт 443, таймаут 10 сек)
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
		Соединение = Новый HTTPСоединение(Сервер, 443, , , , 10, ЗащищенноеСоединение);
		
		ЗапросHTTP = Новый HTTPЗапрос(Ресурс);
		ЗапросHTTP.Заголовки.Вставить("User-Agent", "1C-Enterprise-PetProject/1.0");
		
		ОтветHTTP = Соединение.Получить(ЗапросHTTP);
		КодСостояния = ОтветHTTP.КодСостояния;
		ТелоОтвета = ОтветHTTP.ПолучитьТелоКакСтроку("UTF-8");
		
		Если КодСостояния = 200 Тогда
			// Разбираем JSON-ответ с помощью встроенного объекта ЧтениеJSON
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
			ДанныеОтвета = ПрочитатьJSON(ЧтениеJSON, Истина); // Истина -> читать в Соответствие
			ЧтениеJSON.Закрыть();
			
			СтатусПоиска = ДанныеОтвета.Получить("status");
			Если СтатусПоиска = 1 Тогда
				Продукт = ДанныеОтвета.Получить("product");
				НазваниеТовара = Продукт.Получить("product_name");
				Бренд = Продукт.Получить("brands");
				
				Если Не ЗначениеЗаполнено(НазваниеТовара) Тогда
					НазваниеТовара = "Без названия";
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(Бренд) Тогда
					Бренд = "Не указан";
				КонецЕсли;
				
				Возврат СтрШаблон("HTTP 200 OK | Товар найден во внешнем каталоге: %1 (Бренд: %2)",
					НазваниеТовара, Бренд);
			Иначе
				Возврат СтрШаблон("HTTP 200 OK | Соединение успешно, JSON разобран. Товар с GTIN %1 не зарегистрирован в публичной базе.",
					ПереданныйGTIN);
			КонецЕсли;
		Иначе
			Возврат СтрШаблон("Ошибка HTTP: сервер вернул код состояния %1", КодСостояния);
		КонецЕсли;
		
	Исключение
		// Обработка сетевых ошибок, таймаутов или проблем с SSL-сертификатами
		Возврат "Исключение при выполнении REST-запроса: " + ОписаниеОшибки();
	КонецПопытки;
	
КонецФункции

#КонецОбласти
